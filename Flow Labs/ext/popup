<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Flow Studio</title>

<style>
@import url("https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600&family=Roboto:wght@400;500&display=swap");

*{box-sizing:border-box;margin:0;padding:0}

:root{
  --bg:#202124;
  --surface:#292a2d;
  --surface-hover:#303134;
  --border:#3c4043;
  --border-soft:rgba(232,234,237,.08);

  --text:#e8eaed;
  --text-secondary:#bdc1c6;
  --muted:#9aa0a6;

  --blue:#a8c7fa;
  --blue-text:#062e6f;
  --blue-soft:rgba(168,199,250,.10);

  --green:#81c995;
  --green-soft:rgba(129,201,149,.12);

  --red:#f28b82;
  --red-soft:rgba(242,139,130,.10);

  --google:"Google Sans",Roboto,Arial,sans-serif;
  --roboto:Roboto,Arial,sans-serif;
}

html,body{
  width:380px;
  height:600px;
  overflow:hidden;
  background:var(--bg);
  color:var(--text);
  font-family:var(--google);
}

button{font:inherit}

.app{
  height:600px;
  display:flex;
  flex-direction:column;
}

/* HEADER */

.header{
  height:64px;
  padding:0 16px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  border-bottom:1px solid var(--border);
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
}

.logo{
  width:28px;
  height:28px;
  display:block;
}

.brand-title{
  font-size:16px;
  font-weight:500;
  line-height:20px;
  letter-spacing:-.1px;
}

.brand-subtitle{
  margin-top:1px;
  color:var(--muted);
  font-family:var(--roboto);
  font-size:11px;
  line-height:15px;
}

.version{
  padding:5px 10px;
  border:1px solid var(--border);
  border-radius:20px;
  color:var(--blue);
  background:rgba(168,199,250,.04);
  font-family:var(--roboto);
  font-size:10px;
  font-weight:500;
  letter-spacing:.5px;
}

/* CONTENT */

.content{
  flex:1;
  overflow-y:auto;
  padding:16px;
  scrollbar-width:none;
}

.content::-webkit-scrollbar{display:none}

/* ACCOUNT */

.account{
  padding:18px;
  border:1px solid var(--border);
  border-radius:16px;
  background:
    radial-gradient(circle at 100% 0%,rgba(168,199,250,.07),transparent 38%),
    var(--surface);
  animation:enter .35s ease both;
}

.account-top{
  display:flex;
  align-items:center;
  gap:13px;
}

.avatar{
  width:44px;
  height:44px;
  flex:none;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#394457;
  border:1px solid rgba(168,199,250,.15);
  color:#b6ccff;
  font-size:17px;
  font-weight:500;
}

.account-info{flex:1;min-width:0}

.user-name{
  margin-bottom:4px;
  font-size:15px;
  font-weight:500;
  line-height:20px;
}

.plan-row{
  display:flex;
  align-items:center;
  gap:7px;
  font-family:var(--roboto);
}

.plan-name{
  color:var(--blue);
  font-size:12px;
  font-weight:500;
}

.plan-dot{
  width:3px;
  height:3px;
  border-radius:50%;
  background:var(--muted);
}

.plan-days{
  color:var(--text-secondary);
  font-size:12px;
}

.subscription{
  margin-top:18px;
}

.subscription-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:8px;
  font-family:var(--roboto);
  font-size:11px;
}

.subscription-label{color:var(--muted)}
.subscription-status{color:var(--green)}

.track{
  width:100%;
  height:4px;
  overflow:hidden;
  border-radius:10px;
  background:#3c4043;
}

.progress{
  width:72%;
  height:100%;
  border-radius:inherit;
  background:var(--blue);
  animation:load .8s cubic-bezier(.2,.8,.2,1) both;
}

/* STATS */

.stats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-top:12px;
}

.stat{
  min-height:88px;
  padding:16px;
  border:1px solid var(--border-soft);
  border-radius:14px;
  background:var(--surface);
  animation:enter .35s ease both;
  transition:background .18s ease,transform .18s ease;
}

.stat:nth-child(2){animation-delay:.04s}

.stat:hover{
  background:var(--surface-hover);
  transform:translateY(-1px);
}

.stat-label{
  margin-bottom:10px;
  color:var(--muted);
  font-family:var(--roboto);
  font-size:11px;
  line-height:14px;
}

.stat-value{
  display:flex;
  align-items:baseline;
  gap:5px;
}

.stat-number{
  font-size:26px;
  font-weight:400;
  line-height:28px;
  letter-spacing:-.3px;
}

.stat:first-child .stat-number{color:var(--green)}
.stat:last-child .stat-number{color:var(--blue)}

.stat-unit{
  color:var(--text-secondary);
  font-family:var(--roboto);
  font-size:11px;
}

/* SECTION */

.section{
  margin-top:22px;
  animation:enter .35s .08s ease both;
}

.section-title{
  padding:0 4px;
  margin-bottom:9px;
  color:var(--muted);
  font-family:var(--roboto);
  font-size:11px;
  font-weight:500;
  letter-spacing:.45px;
  text-transform:uppercase;
}

/* FLOW CARD */

.flow-card{
  overflow:hidden;
  border:1px solid var(--border);
  border-radius:16px;
  background:var(--surface);
}

.flow-info-row{
  padding:16px;
  display:flex;
  align-items:center;
  gap:12px;
}

.flow-icon{
  width:38px;
  height:38px;
  flex:none;
  display:grid;
  place-items:center;
  border-radius:12px;
  background:#35363a;
  color:var(--blue);
}

.flow-icon svg{
  width:18px;
  height:18px;
  stroke-width:1.8;
}

.flow-copy{flex:1}

.flow-name{
  margin-bottom:4px;
  font-size:14px;
  font-weight:500;
  line-height:18px;
}

.flow-status{
  display:flex;
  align-items:center;
  gap:7px;
  color:var(--muted);
  font-family:var(--roboto);
  font-size:11px;
}

.status-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:#9aa0a6;
}

.divider{
  height:1px;
  background:var(--border-soft);
}

/* ACTIONS */

.actions{
  padding:12px;
  display:flex;
  gap:10px;
}

.btn{
  height:42px;
  border:0;
  border-radius:22px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  cursor:pointer;
  font-size:13px;
  font-weight:500;
  transition:transform .12s ease,background .18s ease,box-shadow .18s ease;
}

.btn:active{transform:scale(.975)}

.open-btn{
  flex:1;
  background:var(--blue);
  color:var(--blue-text);
}

.open-btn:hover{
  background:#b8d3ff;
  box-shadow:0 2px 6px rgba(0,0,0,.2);
}

.open-btn svg{
  width:17px;
  height:17px;
  stroke-width:2;
}

.disconnect{
  width:42px;
  flex:none;
  background:transparent;
  color:var(--red);
  border:1px solid rgba(242,139,130,.38);
}

.disconnect:hover{background:var(--red-soft)}

.disconnect svg{
  width:17px;
  height:17px;
  stroke-width:1.8;
}

/* BOTTOM NAV */

.bottom-nav{
  height:56px;
  flex:none;
  display:flex;
  border-top:1px solid var(--border);
  background:#242527;
}

.nav{
  flex:1;
  position:relative;
  border:0;
  background:transparent;
  color:var(--muted);
  cursor:pointer;
  font-family:var(--roboto);
  font-size:11px;
  font-weight:500;
  transition:color .18s ease;
}

.nav:hover{color:var(--text)}
.nav.active{color:var(--blue)}

.nav.active:after{
  content:"";
  position:absolute;
  bottom:0;
  left:28px;
  right:28px;
  height:3px;
  border-radius:3px 3px 0 0;
  background:var(--blue);
}

/* ANIMATION */

@keyframes enter{
  from{
    opacity:0;
    transform:translateY(7px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

@keyframes load{
  from{width:0}
  to{width:72%}
}

@media(max-height:560px){
  .content{padding-top:12px}
  .section{margin-top:16px}
}
</style>
</head>

<body>

<div class="app">

  <header class="header">
    <div class="brand">

      <img
        class="logo"
        src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg"
        alt="Google"
      >

      <div>
        <div class="brand-title">Flow Studio</div>
        <div class="brand-subtitle">Google Account Integration</div>
      </div>

    </div>

    <div class="version">V2.0.0</div>
  </header>


  <main class="content">

    <section class="account">

      <div class="account-top">

        <div class="avatar">A</div>

        <div class="account-info">
          <div class="user-name">Admin</div>

          <div class="plan-row">
            <span class="plan-name">ULTRA Plan</span>
            <span class="plan-dot"></span>
            <span class="plan-days">30 days left</span>
          </div>
        </div>

      </div>

      <div class="subscription">

        <div class="subscription-top">
          <span class="subscription-label">Subscription status</span>
          <span class="subscription-status">Active</span>
        </div>

        <div class="track">
          <div class="progress"></div>
        </div>

      </div>

    </section>


    <section class="stats">

      <div class="stat">
        <div class="stat-label">Remaining access</div>

        <div class="stat-value">
          <span class="stat-number">30</span>
          <span class="stat-unit">days</span>
        </div>
      </div>


      <div class="stat">
        <div class="stat-label">Active sessions</div>

        <div class="stat-value">
          <span class="stat-number">2</span>
          <span class="stat-unit">sessions</span>
        </div>
      </div>

    </section>


    <section class="section">

      <div class="section-title">Flow connection</div>

      <div class="flow-card">

        <div class="flow-info-row">

          <div class="flow-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M7 17L17 7"/>
              <path d="M9 7h8v8"/>
            </svg>
          </div>

          <div class="flow-copy">

            <div class="flow-name">Google Flow</div>

            <div class="flow-status">
              <span class="status-dot"></span>
              <span id="statusText">Not connected</span>
            </div>

          </div>

        </div>


        <div class="divider"></div>


        <div class="actions">

          <button class="btn open-btn" id="openFlow">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M7 17L17 7"/>
              <path d="M9 7h8v8"/>
            </svg>

            <span id="openText">Open Google Flow</span>

          </button>


          <button class="btn disconnect" id="disconnect" title="Disconnect">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M12 3v9"/>
              <path d="M7.05 4.93a9 9 0 1 0 9.9 0"/>
            </svg>

          </button>

        </div>

      </div>

    </section>

  </main>


  <nav class="bottom-nav">
    <button class="nav active">Dashboard</button>
    <button class="nav">Extension Portal</button>
  </nav>

</div>


<script>
const openFlow = document.getElementById("openFlow");
const openText = document.getElementById("openText");
const disconnect = document.getElementById("disconnect");
const statusText = document.getElementById("statusText");

openFlow.addEventListener("click", () => {
  const text = openText.textContent;

  openText.textContent = "Opening...";
  openFlow.disabled = true;

  setTimeout(() => {
    openText.textContent = text;
    openFlow.disabled = false;
  }, 650);
});

disconnect.addEventListener("click", () => {
  statusText.textContent = "Disconnected";
});

document.querySelectorAll(".nav").forEach(nav => {
  nav.addEventListener("click", () => {
    document.querySelectorAll(".nav")
      .forEach(item => item.classList.remove("active"));

    nav.classList.add("active");
  });
});
</script>

</body>
</html>