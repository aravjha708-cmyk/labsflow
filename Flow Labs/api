# 3. Ready-to-Use Implementation Code for Your New Project

Here is a clean Node.js standalone module you can copy into your new project.

### File: `clickssySync.js`

```javascript
const fetch = require("node-fetch"); // or native fetch in Node 18+

const CLICKSSY_BASE_URL = process.env.CLICKSSY_BASE_URL || "https://clickssy.online";

/**
 * 1. Authenticate with Clickssy
 */
async function loginToClickssy(email, password) {
  const res = await fetch(`${CLICKSSY_BASE_URL}/api/auth/login`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ email, password }),
  });

  if (!res.ok) {
    const errorText = await res.text().catch(() => "");
    throw new Error(`Clickssy Login failed (${res.status}): ${errorText.slice(0, 200)}`);
  }

  const data = await res.json();
  const userId = data.user?.id || data.id;

  if (!userId) throw new Error("Clickssy login succeeded but no user ID returned");

  return { userId, email };
}

/**
 * 2. Fetch Cookies from Clickssy
 */
async function fetchCookiesFromClickssy(userId, email) {
  const sessionToken = `${userId}:${email}`;

  const res = await fetch(`${CLICKSSY_BASE_URL}/api/extension/verify`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ userId, sessionToken }),
  });

  if (!res.ok) {
    const errorText = await res.text().catch(() => "");
    throw new Error(`Clickssy verify failed (${res.status}): ${errorText.slice(0, 200)}`);
  }

  const data = await res.json();
  if (!data.valid || !data.cookies) {
    throw new Error("Invalid response received from Clickssy");
  }

  // Filter cookies for target domains
  return data.cookies.filter((c) => {
    const name = c.name || c.cookie_name || "";
    const rawDom = (c.domain || c.cookie_domain || "").toLowerCase().trim();
    const cleanDom = rawDom.replace(/^\./, "");

    return (
      !cleanDom ||
      cleanDom === "labs.google" ||
      cleanDom.endsWith("labs.google") ||
      cleanDom === "google.com" ||
      cleanDom.endsWith("google.com") ||
      name.includes("next-auth")
    );
  });
}

/**
 * 3. Complete Sync Routine (Fetch + Persist)
 */
async function syncClickssyCookies(email, password, saveToDbCallback) {
  console.log("[Clickssy Sync] Starting sync...");

  // Step 1: Login
  const { userId } = await loginToClickssy(email, password);

  // Step 2: Fetch & Filter Cookies
  const rawCookies = await fetchCookiesFromClickssy(userId, email);

  // Step 3: Format Cookies
  const formattedCookies = rawCookies.map((c) => ({
    cookie_name: c.name || c.cookie_name,
    cookie_value: c.value || c.cookie_value,
    cookie_domain: c.domain || c.cookie_domain || ".google.com",
    cookie_path: c.path || c.cookie_path || "/",
    secure: c.secure !== false,
    http_only: c.httpOnly !== false,
    same_site: c.sameSite || c.same_site || "lax",
    expiration_date: c.expirationDate || c.expiration_date || null,
    source: "clickssy",
    is_active: true,
    synced_at: new Date().toISOString(),
  }));

  // Step 4: Persist to your Database
  if (typeof saveToDbCallback === "function") {
    await saveToDbCallback(formattedCookies);
  }

  console.log(`[Clickssy Sync] Successfully synced ${formattedCookies.length} cookies.`);
  return formattedCookies;
}

module.exports = {
  loginToClickssy,
  fetchCookiesFromClickssy,
  syncClickssyCookies,
};
```

